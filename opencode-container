#!/bin/bash

set -euo pipefail
trap 'exit 1' INT

BUILD=0
RISKY=0
IMAGE=""
IMAGE_NAME="localhost/opencode-container_opencode-auth-workspace"
SCRIPT_SRC="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SRC" ]; do
  SCRIPT_DIR=$( cd -P "$( dirname "$SCRIPT_SRC" )" >/dev/null 2>&1 && pwd )
  SCRIPT_SRC=$( readlink "$SCRIPT_SRC" )
  [[ "$SCRIPT_SRC" != /* ]] && SCRIPT_SRC="$SCRIPT_DIR/$SCRIPT_SRC"
done
SCRIPT_DIR=$( cd -P "$( dirname "$SCRIPT_SRC" )" >/dev/null 2>&1 && pwd )

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] <directory>

Launch a containerized Open Code workspace in the given directory.

Options:
  -b, --build       Force a rebuild of the container image
  -h, --help        Show this help message and exit
  -i, --image NAME  Use the given container image instead of building one
  --risky           Allow launching when .opencode_mounts.yaml is not ignored

Files:
  .agentsignore  Patterns of files/directories to exclude from the container
                 (format similar to .gitignore)
  .opencode_mounts.yaml  Optional compose override for extra volume mounts
  .opencode_start.sh  Optional script run in the container instead of opencode
                         (mounted read-only, always excluded from workspace)

Checkpointing:
  To save the current container state as an image, find the running container
  and commit it:

    podman ps
    podman commit <container-name> my-checkpoint

  Then resume it later with:

    opencode-container --image my-checkpoint <directory>
EOF
}

# Generate volume mounts from .agentsignore, computing minimal spanning set
generate_volume_mounts() {
  local work_dir=$1
  local agentsignore="$work_dir/.agentsignore"

  if ! command -v fdfind >/dev/null 2>&1; then
    echo "Error: fdfind is required" >&2
    return 1
  fi

  if [[ ! -d "$work_dir" ]]; then
    echo "Error: not a directory: $work_dir" >&2
    return 1
  fi

  if [[ ! -f "$agentsignore" ]]; then
    echo "Error: .agentsignore not found: $agentsignore" >&2
    return 1
  fi

  # .opencode_start.sh is never part of the workspace mounts; it is mounted
  # separately and read-only.
  local tmp_ignore="$(mktemp)"
  cat "$agentsignore" > "$tmp_ignore"
  echo ".opencode_start.sh" >> "$tmp_ignore"

  local status=0
  WORK_DIR="$work_dir" AGENTSIGNORE="$tmp_ignore" python3 "${SCRIPT_DIR}/fd_helper.py" || status=$?
  rm -f "$tmp_ignore"
  return $status
}

# Generate compose override file with selective volume mounts
generate_compose_override() {
  local work_dir=$1
  local mounts=$2
  local agentsignore="$work_dir/.agentsignore"

  local override_file="$(mktemp -d)/compose.override.yml"

  # Fail if .agentsignore doesn't exist
  if [[ ! -f "$agentsignore" ]]; then
    echo "Error: .agentsignore not found: $agentsignore" >&2
    return 1
  fi

  # Get minimal mount set
  local mounts_yaml=""
  while IFS= read -r mount_path; do
    if [[ -n "$mount_path" ]]; then
      mounts_yaml+="      - \${CONTEXT}/$mount_path:/workspace/$mount_path"$'\n'
    fi
  done <<< "$mounts"

  # Mount .opencode_start.sh read-only and run it instead of opencode
  local start_mount=""
  local start_command=""
  if [[ -f "$work_dir/.opencode_start.sh" ]]; then
    start_mount="      - \${CONTEXT}/.opencode_start.sh:/workspace/.opencode_start.sh:ro"$'\n'
    start_command="    command: bash /workspace/.opencode_start.sh"$'\n'
  fi

  # Always include config mounts
  cat > "$override_file" <<EOF
services:
  opencode-auth-workspace:
    volumes:
      - ${OPENCODE_CONFIG_DIR:-~}/.config/opencode:/home/node/.config/opencode
      - ${OPENCODE_CONFIG_DIR:-~}/.opencode/share:/home/node/.local/share/opencode
      - ${OPENCODE_CONFIG_DIR:-~}/.opencode/state:/home/node/.local/state/opencode
${mounts_yaml}${start_mount}${start_command}
EOF

  echo "${override_file}"
}

# Return 0 if .opencode_mounts.yaml would be exposed inside the container.
# It is exposed when the whole workdir (.) or the file itself is mounted.
is_exposed() {
  local mounts=$1
  grep -qxF "." <<< "$mounts" || grep -qxF ".opencode_mounts.yaml" <<< "$mounts"
}

# Generate compose override to use a specific image instead of building
generate_image_override() {
  local image=$1
  local override_file="$(mktemp -d)/compose.image.yml"
  cat > "$override_file" <<EOF
services:
  opencode-auth-workspace:
    image: ${image}
EOF
  echo "${override_file}"
}

# Parse arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -b|--build)
      BUILD=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --risky)
      RISKY=1
      shift
      ;;
    -i|--image)
      if [[ $# -lt 2 ]]; then
        echo "Error: --image requires an argument" >&2
        exit 1
      fi
      IMAGE="$2"
      shift 2
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

set -- ${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

RUN_DIR="$( cd "$(dirname "$( readlink "$0" || ls -1 "$0" )")" > /dev/null && pwd -P )"
echo "RUN DIR: $RUN_DIR"

WORKING_DIR=$( cd "$1" > /dev/null && pwd )
cd "$WORKING_DIR" || exit 1

mkdir -p .opencode

# Generate compose override with selective mounts if .agentsignore exists
MOUNTS=$(generate_volume_mounts "$WORKING_DIR")
OVERRIDE_FILE=$(generate_compose_override "$WORKING_DIR" "$MOUNTS")

# Compose files: base + optional override
COMPOSE_FILES=("-f" "$RUN_DIR/compose.yml" "-f" "$OVERRIDE_FILE")

# Add per-project extra mounts if .opencode_mounts.yaml exists
MOUNTS_FILE="$WORKING_DIR/.opencode_mounts.yaml"
if [[ -f "$MOUNTS_FILE" ]]; then
  if is_exposed "$MOUNTS"; then
    if [[ $RISKY -eq 0 ]]; then
      echo "Error: .opencode_mounts.yaml is not ignored by .agentsignore." >&2
      echo "It defines container mounts and, if visible inside the container," >&2
      echo "can be trivially modified to escape the container." >&2
      echo "Add it to .agentsignore or pass --risky to proceed." >&2
      exit 1
    fi
    echo "Warning: .opencode_mounts.yaml is not in .agentsignore (--risky given)." >&2
  fi
  COMPOSE_FILES+=("-f" "$MOUNTS_FILE")
fi

# Use a specific image instead of building
IMAGE_OVERRIDE=""
if [[ -n "$IMAGE" ]]; then
  if [[ $BUILD -eq 1 ]]; then
    echo "Error: --build and --image are mutually exclusive" >&2
    exit 1
  fi
  IMAGE_OVERRIDE=$(generate_image_override "$IMAGE")
  COMPOSE_FILES+=("-f" "$IMAGE_OVERRIDE")
fi

if [[ $BUILD -eq 1 ]]; then
  CONTEXT="$WORKING_DIR" OPENCODE_CONTAINER_DIR="$RUN_DIR" OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME}" podman compose "${COMPOSE_FILES[@]}" --in-pod false run --rm --build opencode-auth-workspace
else
  CONTEXT="$WORKING_DIR" OPENCODE_CONTAINER_DIR="$RUN_DIR" OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME}" podman compose "${COMPOSE_FILES[@]}" --in-pod false run --rm opencode-auth-workspace
fi

rm -f "$OVERRIDE_FILE"
[[ -n "$IMAGE_OVERRIDE" ]] && rm -f "$IMAGE_OVERRIDE"
